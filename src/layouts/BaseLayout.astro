---
import '../styles/global.css';
import { DEFAULT_THEME, STORAGE_KEY } from '../data/themes';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Platform and DevSecOps engineer.' } = Astro.props;
const pageTitle = title ? `${title} — Aman Bind` : 'Aman Bind';
---

<!doctype html>
<html lang="en" data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    {/* Applies the stored filter before first paint so the page never flashes the default palette. */}
    <script is:inline define:vars={{ storageKey: STORAGE_KEY, fallback: DEFAULT_THEME }}>
      (function () {
        var valid = ['classic', 'octagon', 'machine', 'ristretto', 'spectrum', 'pacific', 'sun'];
        var chosen;
        try {
          chosen = localStorage.getItem(storageKey);
        } catch (e) {
          chosen = null;
        }
        if (valid.indexOf(chosen) === -1) {
          var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          chosen = prefersLight ? 'sun' : fallback;
        }
        document.documentElement.dataset.theme = chosen;
      })();
    </script>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
