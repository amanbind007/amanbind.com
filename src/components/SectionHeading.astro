---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  id?: string;
}
const { eyebrow, title, lede, id } = Astro.props;
---

<div id={id} class="scroll-mt-24">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl" style="color: var(--c-text);">{title}</h2>
  {lede && <p class="mt-4 max-w-2xl text-base leading-relaxed" style="color: var(--c-text-dim);">{lede}</p>}
</div>
