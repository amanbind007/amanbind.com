---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
const d = project.data;

const categoryMeta: Record<string, { label: string; color: string }> = {
  platform: { label: 'Platform', color: 'var(--c-accent)' },
  observability: { label: 'Observability', color: 'var(--c-ok)' },
  cloud: { label: 'Cloud', color: 'var(--c-info)' },
  ios: { label: 'iOS', color: 'var(--c-alt)' },
  ml: { label: 'ML', color: 'var(--c-warn)' },
  homelab: { label: 'Homelab', color: 'var(--c-info)' },
};
const meta = categoryMeta[d.category];
const maxStack = compact ? 4 : 6;
---

<article
  class="card card-hover group flex h-full flex-col p-6"
  data-category={d.category}
  data-featured={String(d.featured)}
>
  <div class="flex items-start justify-between gap-4">
    <span
      class="rounded-md px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-[0.1em]"
      style={`color: ${meta.color}; background: color-mix(in oklab, ${meta.color} 14%, transparent);`}
    >
      {meta.label}
    </span>
    <span class="font-mono text-[0.7rem] whitespace-nowrap" style="color: var(--c-text-faint);">{d.period}</span>
  </div>

  <h3 class="mt-4 text-lg font-semibold leading-snug" style="color: var(--c-text);">
    <a href={`/projects/${project.id}`} class="after:absolute after:inset-0 relative">
      {d.title}
    </a>
  </h3>

  <p class="mt-2.5 flex-1 text-sm leading-relaxed" style="color: var(--c-text-dim);">{d.summary}</p>

  {d.metrics.length > 0 && !compact && (
    <dl class="mt-5 grid grid-cols-2 gap-3">
      {d.metrics.slice(0, 4).map((m) => (
        <div class="rounded-lg border px-3 py-2" style="border-color: var(--c-border); background: var(--c-bg-deep);">
          <dd class="font-mono text-sm font-semibold" style="color: var(--c-ok);">{m.value}</dd>
          <dt class="mt-0.5 text-[0.7rem]" style="color: var(--c-text-faint);">{m.label}</dt>
        </div>
      ))}
    </dl>
  )}

  <ul class="mt-5 flex flex-wrap gap-1.5">
    {d.stack.slice(0, maxStack).map((tech) => (
      <li
        class="rounded border px-1.5 py-0.5 font-mono text-[0.68rem]"
        style="border-color: var(--c-border); color: var(--c-text-faint);"
      >
        {tech}
      </li>
    ))}
    {d.stack.length > maxStack && (
      <li class="px-1 py-0.5 font-mono text-[0.68rem]" style="color: var(--c-text-faint);">
        +{d.stack.length - maxStack}
      </li>
    )}
  </ul>

  <div class="mt-5 flex items-center gap-4 border-t pt-4" style="border-color: var(--c-border);">
    <span class="font-mono text-[0.7rem]" style="color: var(--c-accent);">Read case study →</span>
    {d.proprietary && (
      <span class="ml-auto font-mono text-[0.65rem]" style="color: var(--c-text-faint);" title="Internal work — no public repository">
        internal
      </span>
    )}
    {d.stars !== undefined && d.stars > 0 && (
      <span class="ml-auto font-mono text-[0.7rem]" style="color: var(--c-warn);">★ {d.stars}</span>
    )}
  </div>
</article>
