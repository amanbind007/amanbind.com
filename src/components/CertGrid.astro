---
import { getCollection } from 'astro:content';

const certs = (await getCollection('certifications')).sort((a, b) => b.data.order - a.data.order);

const levelStyle: Record<string, string> = {
  Professional: 'var(--c-accent)',
  Specialty: 'var(--c-alt)',
  Associate: 'var(--c-info)',
  Foundational: 'var(--c-text-faint)',
};
---

<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {certs.map((cert, i) => {
    const c = cert.data;
    const accent = levelStyle[c.level];
    const Tag = c.credential ? 'a' : 'div';
    return (
      <li class="scroll-reveal" style={`transition-delay: ${i * 50}ms;`}>
        <Tag
          href={c.credential}
          target={c.credential ? '_blank' : undefined}
          rel={c.credential ? 'noopener' : undefined}
          class:list={['card flex h-full flex-col p-5', c.credential && 'card-hover']}
        >
          <div class="flex items-center justify-between gap-3">
            <span
              class="rounded px-1.5 py-0.5 font-mono text-[0.62rem] uppercase tracking-[0.1em]"
              style={`color: ${accent}; background: color-mix(in oklab, ${accent} 14%, transparent);`}
            >
              {c.level}
            </span>
            {c.code && (
              <span class="font-mono text-[0.65rem]" style="color: var(--c-text-faint);">{c.code}</span>
            )}
          </div>

          <p class="mt-3 flex-1 text-sm font-medium leading-snug" style="color: var(--c-text);">{c.name}</p>

          <p class="mt-3 flex items-center justify-between gap-2 font-mono text-[0.68rem]">
            <span style={`color: ${c.credential ? 'var(--c-info)' : 'var(--c-text-faint)'};`}>
              {c.credential ? 'Verify on Credly ↗' : 'Credential link pending'}
            </span>
            {c.expires && (
              <span style="color: var(--c-text-faint);">valid to {c.expires}</span>
            )}
          </p>
        </Tag>
      </li>
    );
  })}
</ul>
