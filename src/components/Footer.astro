---
import { site } from '../data/site';

const year = new Date().getFullYear();
const links = [
  { label: 'GitHub', href: site.socials.github },
  { label: 'LinkedIn', href: site.socials.linkedin },
  { label: 'Credly', href: site.socials.credly },
  { label: 'Email', href: site.socials.email },
];
---

<footer class="mt-24 border-t" style="border-color: var(--c-border); background: var(--c-bg-deep);">
  <div class="shell flex flex-col gap-8 py-12 md:flex-row md:items-start md:justify-between">
    <div class="max-w-sm">
      <p class="font-mono text-sm font-semibold" style="color: var(--c-text);">{site.name}</p>
      <p class="mt-2 text-sm" style="color: var(--c-text-faint);">{site.availability}</p>
      <p class="mt-4 text-sm" style="color: var(--c-text-dim);">
        <a href={site.socials.email} class="underline underline-offset-4" style="color: var(--c-info);">{site.email}</a>
      </p>
    </div>

    <nav aria-label="Elsewhere">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              rel="me noopener"
              target={link.href.startsWith('mailto:') ? undefined : '_blank'}
              class="text-sm transition-colors hover:text-[var(--c-accent)]"
              style="color: var(--c-text-dim);"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="shell border-t py-6" style="border-color: var(--c-border);">
    <p class="font-mono text-xs" style="color: var(--c-text-faint);">
      © {year} {site.name} · Built with Astro, React and Tailwind · Themed with Monokai Pro
    </p>
  </div>
</footer>
