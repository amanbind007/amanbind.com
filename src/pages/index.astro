---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { site } from '../data/site';
---

<BaseLayout description={site.tagline}>
  <Hero />

  <section class="shell py-8 sm:py-12">
    <SectionHeading
      id="work"
      eyebrow="Experience"
      title="Where I've worked"
      lede="Three years from shipping a SwiftUI app on my own to owning release engineering for a 70+ microservice enterprise platform."
    />
    <div class="mt-10">
      <ExperienceTimeline />
    </div>
  </section>
</BaseLayout>
